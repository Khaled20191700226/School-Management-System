
<div class="form-container" >

    <form action="Create" method="post" enctype="multipart/form-data">
        
        <div class="form-group">
            <label for="name">Student Name</label>
            <input type="text" id="name" name="StudentName" placeholder="enter your name" />
        </div>

        <div class="form-group">
            <label for="age">Student Age</label>
            <input type="number" id="age" name="StudentAge" placeholder="enter your age" />
        </div>

        <div class=" form-group checkbox-group">
            <input type="checkbox" value="true" id="isActive" name="IsActive" checked />
            <label for="isActive">Is Active</label>
        </div>


        <div class="form-group file-upload">
            <label for="picture">StudentPicture</label>
            <input type="file" id="picture" name="StudentPicture" />            
        </div>



        <input type="submit" value="Save" />
    </form>
</div>





