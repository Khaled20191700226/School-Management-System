@model List<Teacher>


<a class="nav-link text-dark" asp-area="" asp-controller="Teacher" asp-action="Create">Add New Teacher</a>

<br />

<div class="table-container">
    <table>
        <thead>
            <tr>
                <th>Teacher Name</th>
                <th>Teacher Age</th>
                <th>Delete</th>
            </tr>
        </thead>
        <tbody>

            @foreach (Teacher teacher in Model)
            {
                <tr>

                    <td>
                        @teacher.TeacherName
                    </td>
                    <td>
                        @teacher.TeacherAge

                    </td>
                    <td>

                        <a href="/Teacher/Delete/ @teacher.TeacherId ">X</a>

                    </td>



                </tr>

            }

        </tbody>
    </table>
</div>