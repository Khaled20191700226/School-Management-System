@model List<Course>


<a class="nav-link text-dark" asp-area="" asp-controller="Course" asp-action="Create">Add New Course</a>

<br />

<div class="table-container">
    <table>
        <thead>
            <tr>
                <th>Course Name</th>
                <th>Capicity Course</th>
                <th>Delete</th>
            </tr>
        </thead>
        <tbody>

            @foreach (Course course in Model)
            {
                <tr>

                    <td>
                        @course.CourseName
                    </td>
                    <td>
                        @course.CapicityCourse

                    </td>
                    <td>

                        <a href="/Course/Delete/ @course.CourseId ">X</a>

                    </td>



                </tr>

            }

        </tbody>
    </table>
</div>